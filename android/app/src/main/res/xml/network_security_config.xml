<?xml version="1.0" encoding="utf-8"?>
<!-- P0.2/P3: Enforce HTTPS only — no cleartext -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Quran audio CDN is HTTPS — no cleartext needed -->
</network-security-config>