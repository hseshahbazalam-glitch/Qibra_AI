# Development only. Copy to an untracked backend/.env; never commit real values.
QIBRA_ENV=development
QIBRA_SECRET_KEY=replace-with-a-long-random-development-secret
QIBRA_BILLING_WEBHOOK_SECRET=replace-with-a-development-webhook-secret
QIBRA_TOKEN_MINUTES=10080
# Comma-separated browser origins. Required in staging/production; wildcard is never accepted.
QIBRA_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
