# Copy to .env locally. Never commit .env or real secrets.
# JWT_SECRET is required for any real deploy. Do not use replace-me / defaults in production.
JWT_SECRET=replace-me
# Tests use SQLite memory. Production should set PostgreSQL, e.g.
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/qibra
DATABASE_URL=sqlite+pysqlite:///./qibra.db
QIBRA_ENV=development
REFRESH_TOKEN_DAYS=30
AUTH_PRODUCTION_READY=false
CONTENT_PRODUCTION_READY=false
BILLING_PRODUCTION_READY=false
ANALYTICS_PRODUCTION_READY=false
NOTIFICATIONS_LOCAL_ONLY=true
PRECISE_LOCATION_STORED_ON_SERVER=false
