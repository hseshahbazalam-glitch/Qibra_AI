# Qibra AI FastAPI — local configuration
# Copy to backend/.env and adjust. Never commit real secrets.

QIBRA_ENV=development
QIBRA_HOST=0.0.0.0
QIBRA_PORT=8000
QIBRA_JWT_SECRET=change-me-in-production
QIBRA_JWT_EXPIRE_MINUTES=60
QIBRA_DATABASE_PATH=./data/qibra.db
QIBRA_ASSETS_ROOT=../assets/data
QIBRA_CORS_ORIGINS=*
# Optional LLM proxy. Leave empty to use local retrieval-only answers.
QIBRA_LLM_API_KEY=
QIBRA_LLM_BASE_URL=
